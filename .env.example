# connect string supabase env
DATABASE_URL=

# Port
port=3003

# Enable mock data for game-histories API testing
USE_GAME_HISTORIES_MOCK=false
USE_LINE_LOGIN_MOCK=true

# Supabase Admin (service role) — required to create auth.users on first LINE login
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LINE Login channel ID — used to verify ID tokens from LIFF
LINE_CHANNEL_ID=

# Secret used to sign our own app session tokens issued after LINE login
JWT_SECRET=